<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:fitsSystemWindows="true"
    android:orientation="horizontal"
    android:background="@drawable/wehavephones_screen_background">
    <ScrollView
        android:id="@+id/AddonsRail"
        android:layout_width="172dp"
        android:layout_height="match_parent"
        android:background="@drawable/wehavephones_rail_background"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="4dp"
                android:paddingRight="10dp">
                <ImageButton
                    android:id="@+id/BTAddonsBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/wehavephones_addons_back"
                    android:src="@drawable/wehavephones_ic_caret_left"
                    android:tint="@color/wehavephones_on_shell" />
                <TextView
                    style="@style/WeHavePhonesHeader"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:text="@string/wehavephones_addons_title"
                    android:textColor="@color/wehavephones_on_shell"
                    android:textSize="18sp" />
            </LinearLayout>
            <Spinner
                android:id="@+id/SPAddonProduct"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/wehavephones_rail_dropdown"
                android:popupBackground="@drawable/wehavephones_card_background" />
            <ImageView
                style="@style/WeHavePhonesDivider"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="2dp"
                android:layout_height="1dp" />
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/RailAddonsInstalled"
                    style="@style/WeHavePhonesRailItem"
                    android:drawableStart="@drawable/wehavephones_ic_list"
                    android:paddingRight="40dp"
                    android:text="@string/wehavephones_addons_installed" />
                <TextView
                    android:id="@+id/TVAddonsUpdateBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginTop="1dp"
                    android:layout_marginRight="20dp"
                    android:background="@drawable/wehavephones_count_badge"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:minWidth="20dp"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:textColor="@color/wehavephones_blue_dark"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </FrameLayout>
            <TextView
                android:id="@+id/RailAddonsBrowse"
                style="@style/WeHavePhonesRailItem"
                android:drawableStart="@drawable/wehavephones_ic_search"
                android:text="@string/wehavephones_addons_browse" />
            <TextView
                android:id="@+id/RailAddonsApps"
                style="@style/WeHavePhonesRailItem"
                android:drawableStart="@drawable/wehavephones_ic_monitor"
                android:text="@string/wehavephones_addons_apps" />
            <TextView
                android:id="@+id/RailAddonsSettings"
                style="@style/WeHavePhonesRailItem"
                android:drawableStart="@drawable/wehavephones_ic_settings"
                android:text="@string/wehavephones_addons_settings" />
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="8dp" />
            <ProgressBar
                android:id="@+id/PBAddons"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginLeft="14dp"
                android:layout_marginRight="14dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/wehavephones_blue_light"
                android:visibility="gone" />
            <TextView
                android:id="@+id/TVAddonsStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="14dp"
                android:paddingRight="12dp"
                android:paddingTop="4dp"
                android:lineSpacingExtra="1dp"
                android:maxLines="5"
                android:ellipsize="end"
                android:textColor="#A9BDCD"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="8dp"
        android:background="@drawable/wehavephones_lcd_frame"
        android:padding="10dp">
        <FrameLayout
            android:id="@+id/FLAddonsScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="4dp" />
    </FrameLayout>
</LinearLayout>
