<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/WeHavePhonesScreenPadding"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <TextView
        style="@style/WeHavePhonesScreenTitle"
        android:text="@string/wehavephones_diagnostics" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <Button
            android:id="@+id/BTRefresh"
            style="@style/WeHavePhonesButtonSmall"
            android:layout_width="0dp"
            android:layout_marginTop="0dp"
            android:layout_weight="1"
            android:text="@string/wehavephones_diag_refresh" />
        <Button
            android:id="@+id/BTCopy"
            style="@style/WeHavePhonesButtonSmall"
            android:layout_width="0dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="0dp"
            android:layout_weight="1"
            android:text="@string/wehavephones_diag_copy" />
        <Button
            android:id="@+id/BTSaveMemory"
            style="@style/WeHavePhonesButtonSmall"
            android:layout_width="0dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="0dp"
            android:layout_weight="1"
            android:text="@string/wehavephones_diag_memory_save" />
        <Button
            android:id="@+id/BTDeviceUpdate"
            style="@style/WeHavePhonesButtonSmall"
            android:layout_width="0dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="0dp"
            android:layout_weight="2"
            android:text="@string/wehavephones_diag_device_update" />
        <Button
            android:id="@+id/BTDeviceReport"
            style="@style/WeHavePhonesButtonSmall"
            android:layout_width="0dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="0dp"
            android:layout_weight="1.5"
            android:text="@string/wehavephones_diag_device_report" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="9dp"
            android:layout_weight="1"
            android:scrollbars="vertical"
            android:scrollbarStyle="insideInset">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    style="@style/WeHavePhonesSectionLabel"
                    android:layout_marginTop="0dp"
                    android:text="@string/wehavephones_diag_memory_title" />
                <TextView
                    android:id="@+id/TVMemoryPanel"
                    style="@style/WeHavePhonesPanel"
                    android:text="@string/wehavephones_diag_memory_sampling"
                    android:textColor="@color/wehavephones_text"
                    android:textSize="12sp"
                    android:typeface="monospace" />
                <TextView
                    style="@style/WeHavePhonesHint"
                    android:layout_marginTop="6dp"
                    android:text="@string/wehavephones_diag_memory_hint"
                    android:textSize="11sp" />
            </LinearLayout>
        </ScrollView>
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="9dp"
            android:layout_weight="1.4"
            android:scrollbars="vertical"
            android:scrollbarStyle="insideInset">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    style="@style/WeHavePhonesSectionLabel"
                    android:layout_marginTop="0dp"
                    android:text="@string/wehavephones_diag_device_title" />
                <TextView
                    style="@style/WeHavePhonesHint"
                    android:layout_marginTop="6dp"
                    android:text="@string/wehavephones_diag_device_hint"
                    android:textSize="11sp" />
                <LinearLayout
                    android:id="@+id/LLDriverSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:minHeight="44dp"
                    android:background="@drawable/wehavephones_card_background"
                    android:padding="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:contentDescription="@string/wehavephones_diag_driver_title"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginLeft="6dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/TVDriverName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/wehavephones_text_title"
                            android:textSize="15sp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="@string/wehavephones_diag_driver_automatic"
                            android:includeFontPadding="false" />
                        <TextView
                            android:id="@+id/TVDriverMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/wehavephones_text_dim"
                            android:textSize="11sp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="@string/wehavephones_diag_driver_title"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginLeft="8dp"
                        android:src="@drawable/wehavephones_ic_caret_down"
                        android:tint="@color/wehavephones_text_title"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <TextView
                    android:id="@+id/TVDiagnostics"
                    style="@style/WeHavePhonesPanel"
                    android:layout_marginTop="10dp"
                    android:text="@string/wehavephones_diag_empty"
                    android:textColor="@color/wehavephones_text"
                    android:textIsSelectable="true"
                    android:textSize="12sp"
                    android:typeface="monospace" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
