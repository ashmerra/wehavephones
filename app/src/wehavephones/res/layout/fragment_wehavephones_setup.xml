<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="vertical"
    android:scrollbarStyle="insideInset">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="26dp"
        android:paddingRight="26dp"
        android:paddingTop="22dp"
        android:paddingBottom="24dp">
        <TextView
            style="@style/WeHavePhonesScreenTitle"
            android:text="@string/wehavephones_setup_short"
            android:textColor="@color/wehavephones_text_title"
            android:textSize="26sp" />
        <!-- One slim row so Import WoW files stays visible when Setup opens. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:background="@drawable/wehavephones_card_background"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/TVAppUpdateVersion"
                    style="@style/WeHavePhonesSectionLabel"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="2dp" />
                <TextView
                    android:id="@+id/TVAppUpdateHint"
                    style="@style/WeHavePhonesHint" />
            </LinearLayout>
            <CheckBox
                android:id="@+id/CBAutomaticAppUpdates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/wehavephones_update_automatic" />
            <Button
                android:id="@+id/BTCheckAppUpdates"
                style="@style/WeHavePhonesButtonOutline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginStart="12dp"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:gravity="center"
                android:singleLine="true"
                android:text="@string/wehavephones_update_check" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginTop="14dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/wehavephones_card_background"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="12dp">
                <TextView
                    style="@style/WeHavePhonesSectionLabel"
                    android:layout_marginTop="0dp"
                    android:text="@string/wehavephones_settings_container_title" />
                <Spinner
                    android:id="@+id/SPActiveContainer"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/wehavephones_dropdown"
                    android:contentDescription="@string/wehavephones_settings_container_title" />
                <TextView
                    style="@style/WeHavePhonesHint"
                    android:layout_marginTop="9dp"
                    android:text="@string/wehavephones_settings_container_hint"
                    android:textSize="13sp" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/BTNewContainer"
                        style="@style/WeHavePhonesButtonOutline"
                        android:layout_width="wrap_content"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:text="@string/wehavephones_settings_container_new" />
                    <Button
                        android:id="@+id/BTManageContainers"
                        style="@style/WeHavePhonesButtonOutline"
                        android:layout_width="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:text="@string/wehavephones_settings_container_manage" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="24dp"
                android:orientation="vertical"
                android:background="@drawable/wehavephones_card_background"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="12dp">
                <TextView
                    style="@style/WeHavePhonesSectionLabel"
                    android:layout_marginTop="0dp"
                    android:text="@string/wehavephones_import_title" />
                <TextView
                    style="@style/WeHavePhonesHint"
                    android:layout_marginTop="9dp"
                    android:text="@string/wehavephones_import_hint"
                    android:textSize="13sp" />
                <Button
                    android:id="@+id/BTImportWow"
                    style="@style/WeHavePhonesButtonPrimary"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/wehavephones_import_title" />
                <ProgressBar
                    android:id="@+id/PBImportWow"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="10dp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/TVImportWowStatus"
                    style="@style/WeHavePhonesHint"
                    android:layout_marginTop="9dp"
                    android:visibility="gone"
                    android:textSize="13sp" />
                <Button
                    android:id="@+id/BTCancelWowImport"
                    style="@style/WeHavePhonesButtonOutline"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    android:text="@string/cancel" />
            </LinearLayout>
            <!-- Hidden while Play uses one runtime; kept for future profile choices. -->
            <LinearLayout
                android:id="@+id/LLRuntimeProfile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="24dp"
                android:visibility="gone"
                android:orientation="vertical"
                android:background="@drawable/wehavephones_card_background"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="12dp">
                <TextView
                    style="@style/WeHavePhonesSectionLabel"
                    android:layout_marginTop="0dp"
                    android:text="@string/wehavephones_settings_profile_label" />
                <Spinner
                    android:id="@+id/SPRuntimeProfile"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/wehavephones_dropdown"
                    android:contentDescription="@string/wehavephones_settings_profile_label" />
                <TextView
                    android:id="@+id/TVProfileDescription"
                    style="@style/WeHavePhonesHint"
                    android:layout_marginTop="13dp"
                    android:textColor="@color/wehavephones_text"
                    android:textSize="14sp" />
                <TextView
                    style="@style/WeHavePhonesHint"
                    android:layout_marginTop="9dp"
                    android:text="@string/wehavephones_settings_profile_hint"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
