<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/TVKeyName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/wehavephones_text"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/TVKeyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/wehavephones_text_dim"
            android:textSize="11sp" />
    </LinearLayout>
    <Button
        android:id="@+id/BTKeyTest"
        style="@style/WeHavePhonesButtonCompact"
        android:layout_height="34dp"
        android:layout_marginStart="6dp"
        android:text="@string/wehavephones_addons_test_key"
        android:visibility="gone" />
    <Button
        android:id="@+id/BTKeySet"
        style="@style/WeHavePhonesButtonCompact"
        android:layout_height="34dp"
        android:layout_marginStart="6dp"
        android:text="@string/wehavephones_addons_set_key" />
</LinearLayout>
