<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="vertical"
    android:scrollbarStyle="insideInset">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">
        <TextView
            android:id="@+id/TVDetailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/wehavephones_accent"
            android:textSize="19sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/TVDetailStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/wehavephones_text_dim"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/TVDetailAuto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/wehavephones_accent"
            android:textSize="12sp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/TVDetailMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/wehavephones_card_background"
            android:lineSpacingExtra="3dp"
            android:padding="12dp"
            android:textColor="@color/wehavephones_text"
            android:textSize="13sp" />
        <TextView
            style="@style/WeHavePhonesSectionLabel"
            android:text="@string/wehavephones_addons_changelog" />
        <TextView
            android:id="@+id/TVDetailChangelog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/wehavephones_card_background"
            android:lineSpacingExtra="3dp"
            android:padding="12dp"
            android:textColor="@color/wehavephones_text_dim"
            android:textSize="12sp" />
        <Button
            android:id="@+id/BTDetailUpdate"
            style="@style/WeHavePhonesButtonPrimary"
            android:layout_marginTop="12dp"
            android:text="@string/wehavephones_addons_update" />
        <Button
            android:id="@+id/BTDetailToggle"
            style="@style/WeHavePhonesButtonOutline"
            android:text="@string/wehavephones_addons_disable" />
        <Button
            android:id="@+id/BTDetailDelete"
            style="@style/WeHavePhonesButtonOutline"
            android:text="@string/wehavephones_addons_delete" />
    </LinearLayout>
</ScrollView>
