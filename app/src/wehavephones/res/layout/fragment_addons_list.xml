<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal">
        <TextView
            style="@style/WeHavePhonesAddonsTitle"
            android:text="@string/wehavephones_addons_installed" />
        <TextView
            android:id="@+id/TVAddonsSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/wehavephones_text_dim"
            android:textSize="12sp" />
        <Button
            android:id="@+id/BTAddonsUpdateAll"
            style="@style/WeHavePhonesButtonCompactPrimary"
            android:drawableStart="@drawable/wehavephones_ic_download"
            android:visibility="gone" />
        <ImageButton
            android:id="@+id/BTAddonsMore"
            android:layout_width="40dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/wehavephones_button_outline"
            android:contentDescription="@string/wehavephones_addons_more"
            android:src="@drawable/wehavephones_ic_dots_three"
            android:tint="@color/wehavephones_text" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/LLAddonFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView
            android:id="@+id/TVFilterAll"
            style="@style/WeHavePhonesFilterChip" />
        <TextView
            android:id="@+id/TVFilterUpdates"
            style="@style/WeHavePhonesFilterChip"
            android:layout_marginStart="6dp" />
        <TextView
            android:id="@+id/TVFilterDisabled"
            style="@style/WeHavePhonesFilterChip"
            android:layout_marginStart="6dp" />
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbarStyle="insideInset"
        android:scrollbars="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">
            <TextView
                android:id="@+id/TVAddonsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:padding="12dp"
                android:text="@string/wehavephones_addons_empty"
                android:textColor="@color/wehavephones_text_dim"
                android:textSize="13sp"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/LLAddonRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
