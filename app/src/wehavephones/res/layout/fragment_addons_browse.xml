<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal">
        <TextView
            style="@style/WeHavePhonesAddonsTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/wehavephones_addons_browse" />
        <Button
            android:id="@+id/BTBrowseImport"
            style="@style/WeHavePhonesButtonCompact"
            android:text="@string/wehavephones_addons_import_ellipsis" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <Spinner
            android:id="@+id/SPBrowseProvider"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/wehavephones_dropdown"
            android:popupBackground="@drawable/wehavephones_card_background"
            android:visibility="gone" />
        <EditText
            android:id="@+id/ETBrowseQuery"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/wehavephones_field"
            android:drawableStart="@drawable/wehavephones_ic_search"
            android:drawablePadding="8dp"
            android:drawableTint="@color/wehavephones_text_dim"
            android:hint="@string/wehavephones_addons_search_hint"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:textColor="@color/wehavephones_text"
            android:textColorHint="@color/wehavephones_text_dim"
            android:textSize="14sp" />
        <Button
            android:id="@+id/BTBrowseSearch"
            style="@style/WeHavePhonesButtonCompactPrimary"
            android:layout_marginStart="6dp"
            android:text="@string/wehavephones_addons_search" />
    </LinearLayout>
    <TextView
        android:id="@+id/TVBrowseStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/wehavephones_text_dim"
        android:textSize="12sp" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:scrollbarStyle="insideInset"
        android:scrollbars="vertical">
        <LinearLayout
            android:id="@+id/LLBrowseRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp" />
    </ScrollView>
</LinearLayout>
