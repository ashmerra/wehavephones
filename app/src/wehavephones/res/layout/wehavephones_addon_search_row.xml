<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:background="@drawable/wehavephones_card_background"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="50dp"
    android:orientation="horizontal"
    android:paddingLeft="12dp"
    android:paddingRight="8dp">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/TVSearchName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/wehavephones_text"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/TVSearchAuthor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/wehavephones_text_dim"
                android:textSize="12sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/TVSearchSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/wehavephones_text_dim"
            android:textSize="12sp" />
    </LinearLayout>
    <Button
        android:id="@+id/BTSearchInstall"
        style="@style/WeHavePhonesButtonCompactPrimary"
        android:layout_height="34dp"
        android:layout_marginStart="8dp"
        android:text="@string/wehavephones_addons_install" />
    <TextView
        android:id="@+id/TVSearchInstalled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:drawableStart="@drawable/wehavephones_ic_check"
        android:drawablePadding="4dp"
        android:drawableTint="@color/wehavephones_ok"
        android:text="@string/wehavephones_addons_installed"
        android:textColor="@color/wehavephones_ok"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
