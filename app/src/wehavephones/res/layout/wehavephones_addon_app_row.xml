<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/wehavephones_card_background"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingLeft="12dp"
    android:paddingRight="10dp">
    <TextView
        android:id="@+id/TVAppMonogram"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/wehavephones_app_monogram"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textColor="@color/wehavephones_key_text"
        android:textSize="14sp" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/TVAppName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/wehavephones_text"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/TVAppState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/wehavephones_text_dim"
            android:textSize="12sp" />
    </LinearLayout>
    <Button
        android:id="@+id/BTAppOpen"
        style="@style/WeHavePhonesButtonCompactPrimary"
        android:layout_marginStart="8dp" />
</LinearLayout>
