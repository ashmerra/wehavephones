<?xml version="1.0" encoding="utf-8"?>
<!-- Winlator secondary button in the WeHavePhones style (overrides main). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:drawable="@drawable/wehavephones_button_outline_disabled" />
    <item android:state_pressed="true" android:drawable="@drawable/wehavephones_button_outline_pressed" />
    <item android:state_focused="true" android:drawable="@drawable/wehavephones_button_outline_pressed" />
    <item android:drawable="@drawable/wehavephones_button_outline_normal" />
</selector>
