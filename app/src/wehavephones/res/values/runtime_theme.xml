<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="window_background_color">@color/wehavephones_surface</color>
    <color name="colorPrimary">@color/wehavephones_accent</color>
    <color name="colorPrimaryDark">#1265BB</color>
    <color name="colorAccent">@color/wehavephones_accent</color>
    <color name="toolbar_background">@color/wehavephones_background</color>
    <color name="toolbar_title_color">@color/wehavephones_on_shell</color>
    <color name="drawer_background">@color/wehavephones_surface</color>
    <color name="dialog_background">@color/wehavephones_surface</color>
    <color name="secondary_text_color">@color/wehavephones_text_dim</color>
    <color name="fab_icon_color">@color/wehavephones_key_text</color>
    <style name="AppTheme" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/wehavephones_background</item>
        <item name="colorControlNormal">@color/wehavephones_accent</item>
        <item name="colorControlActivated">@color/wehavephones_accent</item>
        <item name="android:windowBackground">@color/window_background_color</item>
        <item name="android:colorBackground">@color/wehavephones_surface</item>
        <item name="android:statusBarColor">@color/wehavephones_background</item>
        <item name="android:navigationBarColor">#071C39</item>
        <item name="android:textColorPrimary">@color/wehavephones_text</item>
        <item name="android:textColorSecondary">@color/wehavephones_text_dim</item>
        <item name="android:textColorHint">@color/wehavephones_text_dim</item>
        <item name="android:textViewStyle">@style/TextView</item>
        <item name="android:checkboxStyle">@style/CheckBox</item>
        <item name="android:listPopupWindowStyle">@style/ListPopupWindow</item>
        <item name="listPopupWindowStyle">@style/ListPopupWindow</item>
        <item name="android:popupWindowStyle">@style/PopupWindow</item>
        <item name="popupWindowStyle">@style/PopupWindow</item>
        <item name="android:popupMenuStyle">@style/PopupMenu</item>
        <item name="popupMenuStyle">@style/PopupMenu</item>
        <item name="alertDialogTheme">@style/WeHavePhonesDialog</item>
        <item name="android:alertDialogTheme">@style/WeHavePhonesDialog</item>
        <item name="floatingActionButtonStyle">@style/WeHavePhonesFab</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:editTextStyle">@style/WeHavePhonesEditText</item>
        <item name="editTextStyle">@style/WeHavePhonesEditText</item>
    </style>
    <style name="WeHavePhonesFab" parent="@style/Widget.Design.FloatingActionButton">
        <item name="backgroundTint">@color/wehavephones_blue</item>
        <item name="rippleColor">@color/wehavephones_blue_light</item>
    </style>
    <style name="TextView" parent="@android:style/Widget.TextView">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/wehavephones_text</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="CheckBox" parent="@style/Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/wehavephones_text</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="ButtonNeutral" parent="BaseButton">
        <item name="android:background">@drawable/button_neutral</item>
        <item name="android:textColor">@color/wehavephones_text_title</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="ButtonPositive" parent="BaseButton">
        <item name="android:background">@drawable/button_positive</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/wehavephones_key_text</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="ToolButton" parent="BaseImageButton">
        <item name="android:layout_marginLeft">2dp</item>
        <item name="android:layout_marginRight">2dp</item>
        <item name="android:tint">@color/wehavephones_accent</item>
    </style>
    <style name="ListMenuButton" parent="BaseImageButton">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:tint">@color/wehavephones_accent</item>
        <item name="android:layout_marginLeft">2dp</item>
        <item name="android:layout_marginRight">2dp</item>
    </style>
    <style name="VerticalLine">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/wehavephones_lcd_edge</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:layout_marginLeft">4dp</item>
        <item name="android:layout_marginRight">4dp</item>
    </style>
    <style name="HorizontalLine">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">2dp</item>
        <item name="android:background">@drawable/wehavephones_rule</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="FieldSeparator">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">#50617C5C</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="FieldSetLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/window_background_color</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingRight">6dp</item>
        <item name="android:layout_marginLeft">8dp</item>
        <item name="android:fontFamily">@font/wehavephones_lcd</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/wehavephones_accent</item>
    </style>
    <style name="TableHeadBackground">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:background">@drawable/table_head_background</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/wehavephones_accent</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="HelpButton">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:layout_marginLeft">4dp</item>
        <item name="android:src">@drawable/icon_help</item>
        <item name="tint">@color/wehavephones_accent</item>
    </style>
    <style name="ContentDialog" parent="@android:style/Theme.Dialog">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@drawable/content_dialog_background</item>
        <item name="android:colorBackground">@color/wehavephones_surface</item>
        <item name="android:textColorPrimary">@color/wehavephones_text</item>
        <item name="android:textColorSecondary">@color/wehavephones_text_dim</item>
        <item name="android:textColor">@color/wehavephones_text</item>
        <item name="android:colorAccent">@color/wehavephones_accent</item>
        <item name="android:editTextStyle">@style/WeHavePhonesEditText</item>
        <item name="android:textViewStyle">@style/TextView</item>
        <item name="android:checkboxStyle">@style/CheckBox</item>
        <item name="android:windowFullscreen">true</item>
    </style>
    <style name="EditText">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/wehavephones_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:background">@drawable/edit_text</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:inputType">text</item>
    </style>
    <style name="BaseButton">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/wehavephones_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="ComboBox">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/wehavephones_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_width">192dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">36dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:spinnerMode">dropdown</item>
        <item name="android:background">@drawable/combo_box</item>
        <item name="android:popupBackground">@drawable/content_dialog_background</item>
    </style>
</resources>
