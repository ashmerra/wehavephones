<?xml version="1.0" encoding="utf-8"?>
<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape
            android:shape="rectangle">
            <corners
                android:radius="10dp" />
            <solid
                android:color="#06162D" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="3dp">
        <shape
            android:shape="rectangle">
            <corners
                android:radius="9dp" />
            <gradient
                android:angle="270"
                android:startColor="#A5B5B8"
                android:endColor="#899CA1" />
            <stroke
                android:width="1dp"
                android:color="#61777C" />
        </shape>
    </item>
</layer-list>
