<?xml version="1.0" encoding="utf-8"?>
<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape
            android:shape="rectangle">
            <corners
                android:radius="20dp" />
            <solid
                android:color="#5D738B" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="3dp">
        <shape
            android:shape="rectangle">
            <corners
                android:radius="19dp" />
            <gradient
                android:angle="270"
                android:startColor="#E6EDF3"
                android:endColor="#AFBECD" />
            <stroke
                android:width="1dp"
                android:color="#F0F5FA" />
        </shape>
    </item>
    <item
        android:left="7dp"
        android:top="7dp"
        android:right="7dp"
        android:bottom="9dp">
        <shape
            android:shape="rectangle">
            <corners
                android:radius="13dp" />
            <gradient
                android:angle="270"
                android:startColor="#BCD0A6"
                android:endColor="#B0C799" />
            <stroke
                android:width="2dp"
                android:color="#365341" />
            <padding
                android:left="10dp"
                android:top="10dp"
                android:right="10dp"
                android:bottom="12dp" />
        </shape>
    </item>
</layer-list>
