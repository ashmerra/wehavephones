<?xml version="1.0" encoding="utf-8"?>
<selector
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_selected="true">
        <shape
            android:shape="rectangle">
            <corners
                android:radius="15dp" />
            <solid
                android:color="@color/wehavephones_accent" />
        </shape>
    </item>
    <item>
        <shape
            android:shape="rectangle">
            <corners
                android:radius="15dp" />
            <solid
                android:color="#26FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#8C365341" />
        </shape>
    </item>
</selector>
