  "bnetBat": "@echo off\r\ncd /d \"C:\\Program Files (x86)\\Battle.net\"\r\nif exist \"C:\\arm64-vkd3d.dll\" copy /Y \"C:\\arm64-vkd3d.dll\" \"C:\\windows\\system32\\d3d12.dll\" >NUL\r\nif exist \"C:\\arm64-libc++.dll\" copy /Y \"C:\\arm64-libc++.dll\" \"C:\\windows\\system32\\libc++.dll\" >NUL\r\nif exist \"C:\\arm64-libunwind.dll\" copy /Y \"C:\\arm64-libunwind.dll\" \"C:\\windows\\system32\\libunwind.dll\" >NUL\r\nBattle.net.exe{flags}\r\n",
